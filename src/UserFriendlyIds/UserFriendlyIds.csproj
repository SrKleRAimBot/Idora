<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Public API: XML docs are part of the deliverable, and a missing one is a build error. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Enables trimming/AOT friendliness checks for consumers who publish trimmed. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <IsPackable>true</IsPackable>
    <PackageId>UserFriendlyIds</PackageId>
    <Version>1.0.0</Version>
    <Authors>Jake Seracino</Authors>
    <Description>Generates human-friendly, prefixed, time-ordered entity identifiers such as usr_01k2f9v8ta7m3x0qbrn4dzeh5c. Each ID carries a per-entity prefix so you can tell what it identifies at a glance, followed by a lowercase ULID (default) or UUIDv7 so IDs sort by creation time and index well. Prefixes are registered once at DI setup, eliminating magic strings and catching collisions at startup.</Description>
    <PackageTags>id;identifier;ulid;uuid;uuidv7;guid;prefix;prefixed-id;sortable;time-ordered;dependency-injection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>
      1.0.0 - Initial release.

      * Identifiers of the form &lt;prefix&gt;_&lt;value&gt;, for example usr_01k2f9v8ta7m3x0qbrn4dzeh5c.
      * Entity prefixes registered once at DI setup; duplicates and malformed prefixes fail at start-up.
      * ULID values by default (26 characters), or UUIDv7 (32 characters) via UseUuidV7().
      * Time-ordered: identifiers sort by creation time as plain strings. ULIDs are strictly
        monotonic per thread, including within a millisecond and across backwards clock steps.
      * One allocation per identifier. Roughly 30ns for ULID and 46ns for UUIDv7, against 226ns
        for Guid.NewGuid().ToString().
      * Targets net8.0, net9.0 and net10.0. Trimming and AOT compatible.
    </PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/SrKleRAimBot/UserFriendlyIds</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SrKleRAimBot/UserFriendlyIds</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Jake Seracino</Copyright>

    <!-- Source Link (built into the SDK) plus a symbols package, so consumers can step into this code. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UserFriendlyIds.Tests" />
    <InternalsVisibleTo Include="UserFriendlyIds.Benchmarks" />
  </ItemGroup>

</Project>
