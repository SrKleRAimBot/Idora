{
  "name": "idora.js-prisma",
  "version": "1.1.0",
  "description": "A Prisma Client extension that gives new rows Idora identifiers such as usr_01k2f9v8ta7m3x0qbrn4dzeh5c: create, createMany, createManyAndReturn and upsert fill in a missing id from the model's registered prefix.",
  "keywords": [
    "idora",
    "prisma",
    "prisma-extension",
    "id",
    "identifier",
    "ulid",
    "uuidv7",
    "prefixed-id",
    "primary-key"
  ],
  "homepage": "https://github.com/SrKleRAimBot/Idora/tree/main/Idora.JS/extensions/prisma#readme",
  "bugs": "https://github.com/SrKleRAimBot/Idora/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SrKleRAimBot/Idora.git",
    "directory": "Idora.JS/extensions/prisma"
  },
  "license": "MIT",
  "author": "Jake Seracino",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:test": "prisma generate --schema test/fixtures/schema.prisma",
    "build:test": "npm run generate:test && tsc -p tsconfig.test.json",
    "typecheck": "npm run generate:test && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build:test && node --test build/test/*.test.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@prisma/client": "^6.0.0 || ^7.0.0",
    "idora.js": "^1.1.0"
  },
  "devDependencies": {
    "@prisma/client": "7.10.1",
    "@types/node": "22.20.5",
    "idora.js": "file:../..",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  }
}
