{
  "name": "idora.js-zod",
  "version": "1.1.0",
  "description": "Zod schemas for Idora identifiers such as usr_01k2f9v8ta7m3x0qbrn4dzeh5c: validate an identifier and its prefix with a precise error, brand it as Id<'usr'>, or decode it into a parsed IdoraId.",
  "keywords": [
    "idora",
    "zod",
    "id",
    "identifier",
    "ulid",
    "uuidv7",
    "prefixed-id",
    "validation",
    "schema"
  ],
  "homepage": "https://github.com/SrKleRAimBot/Idora/tree/main/Idora.JS/extensions/zod#readme",
  "bugs": "https://github.com/SrKleRAimBot/Idora/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SrKleRAimBot/Idora.git",
    "directory": "Idora.JS/extensions/zod"
  },
  "license": "MIT",
  "author": "Jake Seracino",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build:test && node --test build/test/*.test.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "idora.js": "^1.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "idora.js": "file:../..",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
